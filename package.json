{
  "name": "ufsc-moodle-mcp",
  "version": "1.4.0",
  "description": "MCP server para o Moodle da UFSC (presencial.moodle.ufsc.br) — gerenciamento de disciplinas, grupos e mod_groupselect, mensagens, fóruns, entregas individuais e em grupo, download binário preservado para OCR/renderização, extração de texto e avaliação",
  "license": "MIT",
  "author": "Jean Everson Martina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeanmartina/ufsc-moodle-mcp.git"
  },
  "homepage": "https://github.com/jeanmartina/ufsc-moodle-mcp#readme",
  "bugs": {
    "url": "https://github.com/jeanmartina/ufsc-moodle-mcp/issues"
  },
  "type": "module",
  "bin": {
    "ufsc-moodle-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "http-server.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/index.js",
    "serve": "node http-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fflate": "^0.8.3",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
